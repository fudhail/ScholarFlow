# Google Gemini API Configuration (Using Placeholder for Mock Mode)
GOOGLE_API_KEY=AIzaSyBqpARlihzE-HfHAh7dH7A1qljfOlRZgFU

# Mock Toggle - Set to False for production to use real API calls
MOCK_AI_RESPONSES=False

# Database Configuration
DATABASE_URL=sqlite:///./data/scholarflow.db

# Application Settings
APP_ENV=development
DEBUG=true
# Use JSON format for list/complex types in Pydantic V2
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Vector Store Configuration
FAISS_INDEX_PATH=./data/indexes
UPLOAD_PATH=./data/uploads

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# LLM Provider Configuration
# Options: "gemini", "ollama", "hybrid"
LLM_PROVIDER=hybrid

# Ollama Configuration (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_FAST=llama3.2:1b
OLLAMA_MODEL_SMART=scholarmate
OLLAMA_MODEL_SEARCH=scholarflow-search
OLLAMA_MODEL_STUDIO=scholarflow-studio

# Hybrid Mode Settings
USE_OLLAMA_FOR_CHAT=true
USE_OLLAMA_FOR_WRITING=true
USE_GEMINI_FOR_VISION=true

# Research-grounded response policy
RESEARCH_FOCUSED_MODE=true
ENFORCE_PAPER_CITATIONS=true
AUTO_RESEARCH_ON_FACTUAL_QUERIES=true


